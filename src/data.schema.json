{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://expofp.com/floorplans/datajs.schema.json",
    "title": "ExpoFP data.js Schema",
    "type": "object",
    "required": ["title", "homeUrl", "logo", "booths", "exhibitors", "categories"],
    "additionalProperties": false,
    "properties": {
        "title": {
            "type": "string"
        },
        "subtitle": {
            "type": "string"
        },
        "homeUrl": {
            "type": "string",
            "format": "uri"
        },
        "logo": {
            "type": "string"
        },
        "gtag": {
            "type": "string",
            "description": "Google Analytics or Tag Manager ID"
        },
        "reserveInstructions": {
            "type": "string"
        },
        "sendLoginLinkUrl": {
            "type": "string",
            "format": "uri",
            "description": "Endpoint URL to send intructions to exhibitors to edit their data. Should accept `{id: number}` JSON payloads."
        },
        "boothTerm": {
            "type": "string",
            "description": "Booth term (typically 'booth' or 'stand')"
        },
        "booths": {
            "type": "array",
            "items": {
                "type": "object",
                "required": ["id", "name"],
                "additionalProperties": false,
                "properties": {
                    "id": {
                        "type": "number"
                    },
                    "name": {
                        "type": "string"
                    },
                    
                    "special": {
                        "type": "boolean",
                        "description": "When true - may have `title`, `description` and `color` fields. "
                    },
                    "title": {
                        "type": "string",
                        "description": "Only for special=true"
                    },
                    "description": {
                        "type": "string",
                        "description": "HTML. Only for special=true"
                    },
                    "color": {
                        "type": "string",
                        "description": "Only for special=true"
                    },
                    "exhibitors": {
                        "type": "array",
                        "items": {
                            "type": "number"
                        },
                        "description": "HTML. Only for special=false"
                    },
                    "type": {
                        "type": "string",
                        "description": "HTML. Only for special=false"
                    },
                    "size": {
                        "type": "string",
                        "description": "HTML. Only for special=false"
                    },
                    "price": {
                        "type": "string",
                        "description": "HTML. Only for special=false"
                    },
                   
                    "availColor": {
                        "type": "string",
                        "description": "HTML. Only for special=false"
                    },
                    "soldColor": {
                        "type": "string",
                        "description": "HTML. Only for special=false"
                    },
                    "typeColor": {
                        "type": "string",
                        "description": "HTML. Only for special=false"
                    },
                    "buyUrl": {
                        "type": "string",
                        "description": "HTML. Only for special=false"
                    },
                    "onHold": {
                        "type": "boolean",
                        "description": "HTML. Only for special=false"
                    }
                }
            }
        },
        "exhibitors": {
            "type": "array",
            "items": {
                "type": "object",
                "required": ["id", "name"],
                "additionalProperties": false,
                "properties": {
                    "id": {
                        "type": "number"
                    },
                    "name": {
                        "type": "string"
                    },
                    "categories": {
                        "type": "array",
                        "items": {
                            "type": "number"
                        }
                    },
                    "featured": {
                        "type": "boolean"
                    },
                    "advertise": {
                        "type": "boolean"
                    },
                    "description": {
                        "type": "string"
                    },
                    "logo": {
                        "type": "string"
                    },
                    "address": {
                        "type": "string"
                    },
                    "address2": {
                        "type": "string"
                    },
                    "city": {
                        "type": "string"
                    },
                    "state": {
                        "type": "string"
                    },
                    "zip": {
                        "type": "string"
                    },
                    "country": {
                        "type": "string"
                    },
                    "phone1": {
                        "type": "string"
                    },
                    "email": {
                        "type": "string",
                        "format": "email"
                    },
                    "privateEmail": {
                        "type": "string",
                        "description": "Presentation of private email of exhibitor - with hidden characters in it - hard to guess"
                    },
                    "website": {
                        "type": "string",
                        "format": "uri"
                    },
                    "facebook": {
                        "type": "string",
                        "format": "uri"
                    },
                    "instagram": {
                        "type": "string",
                        "format": "uri"
                    },
                    "linkedin": {
                        "type": "string",
                        "format": "uri"
                    },
                    "twitter": {
                        "type": "string",
                        "format": "uri"
                    },
                    "googlePlus": {
                        "type": "string",
                        "format": "uri"
                    },
                    "xing": {
                        "type": "string",
                        "format": "uri"
                    },
                    "youtube": {
                        "type": "string",
                        "format": "uri"
                    }
                }
            }
        },
        "categories": {
            "type": "array",
            "items": {
                "type": "object",
                "required": ["id", "name"],
                "additionalProperties": false,
                "properties": {
                    "id": {
                        "type": "number"
                    },
                    "name": {
                        "type": "string"
                    }
                }
            }
        }
    }
}